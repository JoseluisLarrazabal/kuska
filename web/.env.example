# --- Cliente (Vite, prefijo VITE_ obligatorio, se embeben en el bundle) ---
VITE_CHAIN_ID=133
VITE_ESCROW_ADDRESS=0x0000000000000000000000000000000000000000
VITE_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
VITE_DEPLOY_BLOCK=0
# Debe ser una dirección DISTINTA del árbitro (escrow.arbiter()) y del
# comprador de demo (la cuenta burner local). Si coincide con el árbitro, el
# relato de la demo se rompe (el árbitro no puede ser también el vendedor) y
# puede chocar con alguna guarda del contrato. El vendedor de demo solo firma
# mensajes EIP-712 (todo lo firmado es permissionless, lo envía el relayer),
# así que esta cuenta NO necesita gas — no hace falta fondearla con HSK.
VITE_DEMO_SELLER=0x0000000000000000000000000000000000000000

# --- Mainnet (HSK Chain 177) — comentado, NO son los defaults activos.
# Descomentar (y pisar los VITE_/de servidor de arriba) para apuntar a
# mainnet; VITE_DEMO_SELLER y RELAYER_PRIVATE_KEY siguen siendo específicos
# de cada deployment, no van acá.
# VITE_CHAIN_ID=177
# VITE_ESCROW_ADDRESS=0x955e09d2D14431f491F8E80A4db3CE82A2b3Dba1
# VITE_TOKEN_ADDRESS=0x1dfAC4096b94Ed6d892223573d289B8165695dB0
# VITE_DEPLOY_BLOCK=27470785

# --- Servidor (relayer, NUNCA con prefijo VITE_, nunca commitear valores reales) ---
CHAIN_ID=133
RPC_URL=https://testnet.hsk.xyz
ESCROW_ADDRESS=0x0000000000000000000000000000000000000000
TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
RELAYER_PRIVATE_KEY=0x1111111111111111111111111111111111111111111111111111111111111111

# --- Servidor mainnet (HSK Chain 177) — comentado, NO son los defaults activos.
# CHAIN_ID=177
# RPC_URL=https://mainnet.hsk.xyz
# ESCROW_ADDRESS=0x955e09d2D14431f491F8E80A4db3CE82A2b3Dba1
# TOKEN_ADDRESS=0x1dfAC4096b94Ed6d892223573d289B8165695dB0
